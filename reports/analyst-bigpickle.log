import websocket
import json
import time
import urllib.request

# Step 1: Get fresh sid via polling
url_poll = "https://staging-alerts.rainbet.com/socket.io/?EIO=4&transport=polling"
req = urllib.request.Request(url_poll, headers={"User-Agent": "Mozilla/5.0"})
resp = urllib.request.urlopen(req, timeout=10)
poll_data = resp.read().decode()
print(f"[POLL] {poll_data[:200]}")

sid_data = json.loads(poll_data[1:])
sid = sid_data["sid"]
print(f"[SID] {sid}")

# Step 2: WebSocket upgrade
ws_url = f"wss://staging-alerts.rainbet.com/socket.io/?EIO=4&transport=websocket&sid={sid}"
print(f"[WS] connecting to {ws_url}")

ws = websocket.create_connection(ws_url, timeout=15, header=["User-Agent: Mozilla/5.0"])
print(f"[WS] connected")

# Step 3: Send probe
ws.send("2probe")
print("[WS SEND] 2probe")
time.sleep(0.3)

ws.settimeout(5)
try:
    data = ws.recv()
    print(f"[WS RECV] {data}")
except Exception as e:
    print(f"[WS] probe recv error: {e}")

# Step 4: Send upgrade
ws.send("5")
print("[WS SEND] 5 (upgrade)")
time.sleep(1)

try:
    data = ws.recv()
    print(f"[WS RECV after upgrade] {data}")
except websocket.WebSocketTimeoutException:
    print("[WS] no response to upgrade (timeout)")
except Exception as e:
    print(f"[WS] upgrade recv error: {e}")

# Step 5: Try to read any pending data
time.sleep(0.5)
try:
    ws.settimeout(2)
    data = ws.recv()
    print(f"[WS RECV pending] {data}")
except:
    pass

# Step 6: Connect to root namespace
ws.send("40")
print("[WS SEND] 40 (CONNECT /)")
time.sleep(1)

ws.settimeout(5)
for i in range(5):
    try:
        data = ws.recv()
        print(f"[WS RECV NS {i}] {data}")
    except websocket.WebSocketTimeoutException:
        print(f"[WS] timeout on namespace recv {i}")
        break

# Step 7: If connected, try /chat namespace
try:
    ws.send('42["0","/chat"]')
    print('[WS SEND] 42["0","/chat"]')
    time.sleep(1.5)
    
    for i in range(5):
        try:
            data = ws.recv()
            print(f"[WS RECV CHAT {i}] {data}")
        except websocket.WebSocketTimeoutException:
            print(f"[WS] timeout on chat recv {i}")
            break
except Exception as e:
    print(f"[WS] chat send error: {e}")

ws.close()
print("[WS] closed")

import socket, ssl, base64, os, time, json, re, urllib.request

HOST = "staging-chat.rainbet.com"
LISTEN = 40

def poll_sid(host):
    req = urllib.request.Request(f"https://{host}/socket.io/?EIO=4&transport=polling",
        headers={"User-Agent":"Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"})
    body = urllib.request.urlopen(req, timeout=15).read().decode()
    m = re.search(r'"sid":"([^"]+)"', body)
    print("[POLL]", body[:120])
    return m.group(1) if m else None

def ws_handshake(host, sid):
    ctx = ssl.create_default_context()
    sock = socket.create_connection((host, 443), timeout=15)
    ws = ctx.wrap_socket(sock, server_hostname=host)
    key = base64.b64encode(os.urandom(16)).decode()
    req = (f"GET /socket.io/?EIO=4&transport=websocket&sid={sid} HTTP/1.1\r\n"
           f"Host: {host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
           f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n"
           "User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0\r\n\r\n")
    ws.sendall(req.encode())
    buf = b""
    while b"\r\n\r\n" not in buf:
        c = ws.recv(4096)
        if not c: break
        buf += c
    hdr, _, rest = buf.partition(b"\r\n\r\n")
    first = hdr.split(b"\r\n")[0].decode()
    print("[WS]", first)
    return ws, rest, "101" in first

def send_frame(ws, payload):
    if isinstance(payload, str): payload = payload.encode()
    mask = os.urandom(4)
    masked = bytes(b ^ mask[i%4] for i,b in enumerate(payload))
    head = bytearray([0x81])
    ln = len(masked)
    if ln < 126: head.append(0x80|ln)
    head += mask + masked
    ws.sendall(bytes(head))
    print(f"[SEND] {payload[:70]!r}")

def parse_frames(data):
    frames=[]
    while len(data)>=2:
        opcode=data[0]&0x0F; b1=data[1]; ln=b1&0x7F; idx=2
        if ln==126: ln=int.from_bytes(data[2:4],'big'); idx=4
        elif ln==127: ln=int.from_bytes(data[2:10],'big'); idx=10
        masked=b1&0x80
        mask=None
        if masked: mask=data[idx:idx+4]; idx+=4
        payload=data[idx:idx+ln]; data=data[idx+ln:]
        if masked and mask: payload=bytes(b^mask[i%4] for i,b in enumerate(payload))
        frames.append((opcode,payload))
    return frames,data

for attempt in range(1,4):
    sid = poll_sid(HOST)
    if not sid: 
        print("no sid"); time.sleep(2); continue
    ws, buf, ok = ws_handshake(HOST, sid)
    if not ok:
        print(f"[try {attempt}] WS 400 on sid {sid}; retry")
        time.sleep(2)
        continue
    buf_leftover = buf
    def drain(ws, buf, secs, label):
        frames, leftover = parse_frames(buf)
        t0=time.time()
        while time.time()-t0 < secs:
            ws.settimeout(max(0.5, secs-(time.time()-t0)))
            try: chunk=ws.recv(65536)
            except socket.timeout: break
            except Exception: break
            if not chunk: break
            leftover += chunk
            fs, leftover = parse_frames(leftover)
            for op,p in fs: print(f"[{label} RECV] {p[:150]!r}")
        return leftover
    buf_leftover = drain(ws, buf_leftover, 1.0, "pre")
    send_frame(ws,"2probe")
    buf_leftover = drain(ws, buf_leftover, 2.0, "probe")
    send_frame(ws,"5")
    time.sleep(0.3)
    send_frame(ws,"40")  # root CONNECT
    buf_leftover = drain(ws, buf_leftover, 3.0, "root40")
    print(f"[LISTEN {LISTEN}s root ns]")
    t0=time.time(); seq=0
    while time.time()-t0 < LISTEN:
        frames, buf_leftover = parse_frames(buf_leftover)
        for op,p in frames:
            seq+=1; print(f"[EV {seq}] op={op} {p[:180]!r}")
        ws.settimeout(2.0)
        try: chunk=ws.recv(65536)
        except socket.timeout: continue
        except Exception: print("[EOF/ERR]"); break
        if not chunk: print("[CLOSED]"); break
        buf_leftover += chunk
    print(f"[LISTEN] frames={seq} in {LISTEN}s")
    print("[NS enum]")
    for ns in ["/chat,","/wager,","/live,","/notifications,","/wallet,","/users,","/alerts,","/raffles,"]:
        send_frame(ws,"40"+ns)
        buf_leftover = drain(ws, buf_leftover, 1.2, "ns"+ns)
        time.sleep(0.4)
    ws.close()
    print("=== DONE (round", attempt, ") ===")
    break
EOF

#!/bin/bash
UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
EVIL="https://evil.example"
probe() {
  local label="$1"; local url="$2"; local method="$3"; local origin="$4"
  local hdr=(-s -m 15 -o /tmp/body -w '%{http_code}' -A "$UA" -X "$method" -D /tmp/hdr)
  if [ -n "$origin" ]; then hdr+=(-H "Origin: $origin"); fi
  local code
  code=$(curl "${hdr[@]}" "$url")
  local bytes ctype allow doorig doapp cfmit a cao cac vary loc server pw
  bytes=$(wc -c </tmp/body)
  ctype=$(awk 'tolower($1)=="content-type:"{gsub("\r","");print $2}' /tmp/hdr | head -1)
  allow=$(awk 'tolower($1)=="allow:"{gsub("\r","");sub("^ ","");print $0}' /tmp/hdr | head -1)
  doorig=$(grep -i '^x-do-orig-status:' /tmp/hdr | tr -d '\r' | awk '{print $2}' | head -1)
  doapp=$(grep -i '^x-do-app-origin:' /tmp/hdr | tr -d '\r' | awk '{print $2}' | head -1)
  cfmit=$(grep -i '^cf-mitigated:' /tmp/hdr | tr -d '\r' | awk '{print $2}' | head -1)
  a=$(grep -i '^access-control-allow-origin:' /tmp/hdr | tr -d '\r' | awk '{print $2}' | head -1)
  cac=$(grep -i '^access-control-allow-credentials:' /tmp/hdr | tr -d '\r' | awk '{print $2}' | head -1)
  vary=$(grep -i '^vary:' /tmp/hdr | tr -d '\r' | sed 's/^[Vv]ary: //' | head -1)
  loc=$(grep -i '^location:' /tmp/hdr | tr -d '\r' | awk '{print $2}' | head -1)

import http.client, re, sys, time

def eio(host, sid=None, body=None, extra=""):
    c = http.client.HTTPSConnection(host, 443, timeout=12)
    path = f"/socket.io/?EIO=4&transport=polling&sid={sid}{extra}" if sid else "/socket.io/?EIO=4&transport=polling"
    if body is None:
        c.request("GET", path, headers={"User-Agent": "Mozilla/5.0 Chrome/126.0", "Origin": "https://evil.example"})
    else:
        c.request("POST", path, body=body, headers={"User-Agent": "Mozilla/5.0 Chrome/126.0", "Origin": "https://evil.example", "Content-Type": "text/plain;charset=UTF-8"})
    r = c.getresponse()
    data = r.read().decode(errors="replace")
    out = (r.status, len(data), data[:160])
    c.close()
    return out

def main(host):
    st, ln, data = eio(host)
    print(f"[{host}] poll: {st} {ln}B {data}")
    m = re.search(r'"sid":"([^"]+)"', data)
    if not m:
        print(f"[{host}] no sid"); return
    sid = m.group(1)
    st, ln, data = eio(host, sid=sid, body="40")
    print(f"[{host}] POST 40: {st} {ln}B {data!r}")
    time.sleep(1)
    st, ln, data = eio(host, sid=sid)
    print(f"[{host}] poll-after: {st} {ln}B {data!r}")
    time.sleep(1)
    st, ln, data = eio(host, sid=sid)
    print(f"[{host}] poll-after2: {st} {ln}B {data!r}")

main(sys.argv[1])
EOF

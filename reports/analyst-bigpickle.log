import socket, ssl, base64, os, json, time, sys, re

HOST = sys.argv[1] if len(sys.argv) > 1 else "staging-chat.rainbet.com"
LISTEN = float(sys.argv[2]) if len(sys.argv) > 2 else 45.0
NAMESPACES = ["/chat", "/wager", "/live", "/raffles", "/alerts", "/notifications", "/wallet", "/users"]

def poll_sid(host):
    import http.client
    c = http.client.HTTPSConnection(host, 443, timeout=10)
    c.request("GET", "/socket.io/?EIO=4&transport=polling",
              headers={"User-Agent": "Mozilla/5.0 Chrome/126.0",
                       "Origin": "https://evil.example"})
    r = c.getresponse(); body = r.read().decode(errors="replace")
    c.close()
    m = re.search(r'"sid":"([^"]+)"', body)
    return m.group(1) if m else None, body[:80], r.status

def ws_connect(host, sid):
    sock = socket.create_connection((host, 443), timeout=10)
    ctx = ssl.create_default_context()
    s = ctx.wrap_socket(sock, server_hostname=host)
    key = base64.b64encode(os.urandom(16)).decode()
    req = (f"GET /socket.io/?EIO=4&transport=websocket&sid={sid} HTTP/1.1\r\n"
           f"Host: {host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
           f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n"
           f"Origin: https://evil.example\r\nUser-Agent: Mozilla/5.0 Chrome/126.0\r\n\r\n")
    s.sendall(req.encode())
    buf = b""
    while b"\r\n\r\n" not in buf:
        buf += s.recv(4096)
    head, _, rest = buf.partition(b"\r\n\r\n")
    status = head.decode(errors="replace").split("\r\n")[0]
    return s, rest, status

def read_frame(s):
    hdr = s.recv(2)
    if len(hdr) < 2: return None
    b0, b1 = hdr[0], hdr[1]
    opcode = b0 & 0x0F
    ln = b1 & 0x7F
    if ln == 126:
        ln = int.from_bytes(s.recv(2), "big")
    elif ln == 127:
        ln = int.from_bytes(s.recv(8), "big")
    mask = b1 & 0x80
    if mask:
        mk = s.recv(4)
    payload = s.recv(ln)
    while len(payload) < ln:
        payload += s.recv(ln - len(payload))
    if mask:
        payload = bytes(c ^ mk[i % 4] for i, c in enumerate(payload))
    return opcode, payload

def send_text(s, text):
    p = text.encode()
    mask = os.urandom(4)
    header = bytes([0x81])
    ln = len(p)
    if ln < 126:
        header += bytes([0x80 | ln])
    elif ln < 65536:
        header += bytes([0x80 | 126]) + ln.to_bytes(2, "big")
    else:
        header += bytes([0x80 | 127]) + ln.to_bytes(8, "big")
    header += mask
    masked = bytes(c ^ mask[i % 4] for i, c in enumerate(p))
    s.sendall(header + masked)

sid, snippet, st = poll_sid(HOST)
print(f"[{HOST}] poll sid={sid} status={st} snippet={snippet}")
if not sid:
    sys.exit(0)

s, rest, status = ws_connect(HOST, sid)
print(f"[{HOST}] WS upgrade: {status}")
if rest:
    opc, pay = (1, rest)
    if opc == 1: print(f"[{HOST}] pre-frame: {pay.decode(errors='replace')[:100]}")

connected = False
end = time.time() + LISTEN
pongs = 0
out = []
# send root CONNECT right away
send_text(s, "40")
print(f"[{HOST}] sent CONNECT 40")
s.settimeout(2)
start_listen = time.time()
while time.time() < end:
    try:
        f = read_frame(s)
    except socket.timeout:
        continue
    except (ConnectionResetError, BrokenPipeError) as e:
        print(f"[{HOST}] closed: {e}"); break
    if f is None:
        print(f"[{HOST}] closed: EOF"); break
    opc, pay = f
    if opc == 8:
        print(f"[{HOST}] close frame rcvd"); break
    if opc == 9:
        send_text(s, bytes([0x0A])[:0].decode() if False else "")  # noop guard
        continue
    if opc in (1, 2):
        txt = pay.decode(errors="replace")
        if txt == "2":
            pongs += 1
            send_text(s, "3")
            print(f"[{HOST}] pong#{pongs} sent")
        elif txt.startswith("40"):
            connected = True
            print(f"[{HOST}] CONNECT-ACK: {txt[:120]}")
            # enum candidates BEFORE waiting (methodology fix)
            for ns in NAMESPACES + ["/originals", "/bonuses"]:
                send_text(s, f"40{ns},")
            print(f"[{HOST}] sent {len(NAMESPACES)+2} namespace joins")
        elif txt.startswith("44"):
            print(f"[{HOST}] CONNECT-ERR: {txt[:120]}")
        else:
            out.append(txt[:120])
            print(f"[{HOST}] frame: {txt[:120]}")
    elif opc == 0:
        print(f"[{HOST}] continu...")
print(f"[{HOST}] DONE listen={time.time()-start_listen:.1f}s pongs={pongs} connected={connected}")
print(f"[{HOST}] frames after ns-join: {out}")
s.close()
EOF

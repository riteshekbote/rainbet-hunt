import websocket
import json
import time
import urllib.request

# Step 1: Get fresh sid
url_poll = "https://staging-alerts.rainbet.com/socket.io/?EIO=4&transport=polling"
req = urllib.request.Request(url_poll, headers={"User-Agent": "Mozilla/5.0"})
resp = urllib.request.urlopen(req, timeout=10)
poll_data = resp.read().decode()
sid_data = json.loads(poll_data[1:])
sid = sid_data["sid"]
print(f"[SID] {sid}")

# Step 2: WebSocket
ws_url = f"wss://staging-alerts.rainbet.com/socket.io/?EIO=4&transport=websocket&sid={sid}"
ws = websocket.create_connection(ws_url, timeout=15, header=["User-Agent: Mozilla/5.0"])
print(f"[WS] connected")

# Probe + upgrade
ws.send("2probe")
ws.settimeout(5)
data = ws.recv()
print(f"[PROBE] {data}")
ws.send("5")
time.sleep(1)
try:
    ws.settimeout(2)
    data = ws.recv()
    print(f"[UPGRADE] {data}")
except:
    print("[UPGRADE] no response")

# Test: root namespace with empty auth
ws.send("40{}")
print("[SEND] 40{} (root ns, empty auth)")
time.sleep(1)
ws.settimeout(5)
for i in range(3):
    try:
        data = ws.recv()
        print(f"[RECV root {i}] {data}")
    except:
        break

# Test: /chat namespace
ws.send('42["1","/chat"]')
print('[SEND] 42["1","/chat"]')
time.sleep(1)
for i in range(3):
    try:
        data = ws.recv()
        print(f"[RECV chat {i}] {data}")
    except:
        break

# Test: /alerts namespace  
ws.send('42["2","/alerts"]')
print('[SEND] 42["2","/alerts"]')
time.sleep(1)
for i in range(3):
    try:
        data = ws.recv()
        print(f"[RECV alerts {i}] {data}")
    except:
        break

# Try socket.io CONNECT format for /chat: "40/chat,"

import websocket
import json
import time
import urllib.request

def test_socket(host, label):
    print(f"\n=== {label} ===")
    url_poll = f"https://{host}/socket.io/?EIO=4&transport=polling"
    req = urllib.request.Request(url_poll, headers={"User-Agent": "Mozilla/5.0"})
    resp = urllib.request.urlopen(req, timeout=10)
    poll_data = resp.read().decode()
    sid_data = json.loads(poll_data[1:])
    sid = sid_data["sid"]
    print(f"[SID] {sid}")

    ws_url = f"wss://{host}/socket.io/?EIO=4&transport=websocket&sid={sid}"
    ws = websocket.create_connection(ws_url, timeout=15, header=["User-Agent: Mozilla/5.0"])
    print(f"[WS] connected")

    # Probe + upgrade
    ws.send("2probe")
    ws.settimeout(5)
    data = ws.recv()
    print(f"[PROBE] {data}")
    ws.send("5")
    time.sleep(0.5)
    try:
        ws.settimeout(2)
        data = ws.recv()
        print(f"[UPGRADE] {data}")
    except:
        print("[UPGRADE] no response (normal for eio v4)")

    # Try root namespace with fake token
    ws.send('40{"token":"fake_jwt_token_test_123"}')
    print('[SEND] 40 with fake token')
    time.sleep(1)
    ws.settimeout(5)
    for i in range(3):
        try:
            data = ws.recv()
            print(f"[RECV {i}] {data}")
        except:
            break
    
    ws.close()


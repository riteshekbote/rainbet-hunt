import websocket
import json
import time
import sys

# Step 1: Get fresh sid via polling
import urllib.request
url_poll = "https://staging-alerts.rainbet.com/socket.io/?EIO=4&transport=polling"
req = urllib.request.Request(url_poll, headers={"User-Agent": "Mozilla/5.0"})
resp = urllib.request.urlopen(req, timeout=10)
poll_data = resp.read().decode()
print(f"[POLL] {poll_data[:200]}")

# Parse sid from polling response
# Format: 0{"sid":"...","upgrades":["websocket"],...}
sid_data = json.loads(poll_data[1:])  # strip leading '0'
sid = sid_data["sid"]
print(f"[SID] {sid}")

# Step 2: WebSocket upgrade
ws_url = f"wss://staging-alerts.rainbet.com/socket.io/?EIO=4&transport=websocket&sid={sid}"
print(f"[WS] connecting to {ws_url}")

ws = websocket.create_connection(ws_url, timeout=10, header=["User-Agent: Mozilla/5.0"])
print(f"[WS] connected")

# Step 3: Send engine.io ping (probe)
ws.send("2probe")
time.sleep(0.5)

# Read response
ws.settimeout(3)
try:
    data = ws.recv()
    print(f"[WS RECV] {data}")
except websocket.WebSocketTimeoutException:
    print("[WS] no response to probe")

# Step 4: Send upgrade packet
ws.send("5")
time.sleep(0.5)
try:
    data = ws.recv()
    print(f"[WS RECV] {data}")
except websocket.WebSocketTimeoutException:
    print("[WS] no response to upgrade")

# Step 5: Try namespace connect to /chat
ns_msg = '42["0","/chat"]'
ws.send(ns_msg)
print(f"[WS SEND] {ns_msg}")
time.sleep(1)

# Read all available data
ws.settimeout(3)
for i in range(5):
    try:
        data = ws.recv()
        print(f"[WS RECV {i}] {data}")
    except websocket.WebSocketTimeoutException:
        print(f"[WS] timeout after {i} recv attempts")
        break

# Step 6: Try namespace connect to /raffles
ns_msg2 = '42["0","/raffles"]'
ws.send(ns_msg2)
print(f"[WS SEND] {ns_msg2}")
time.sleep(1)

for i in range(5):
    try:
        data = ws.recv()
        print(f"[WS RECV RAFFLES {i}] {data}")
    except websocket.WebSocketTimeoutException:
        print(f"[WS] timeout after {i} recv attempts (raffles)")
        break

ws.close()
print("[WS] closed")
